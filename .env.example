# Flask configuration
FLASK_SECRET_KEY=your-flask-secret-key-change-this
FLASK_PORT=5001
FLASK_DEBUG=True

# Instagram provider configuration
# Choose: 'mock' (default, for local testing without credentials) or 'graph' (real Graph API)
INSTAGRAM_PROVIDER=mock

# Required if INSTAGRAM_PROVIDER=graph
INSTAGRAM_ACCESS_TOKEN=your-instagram-graph-api-access-token
